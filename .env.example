# Base de desarrollo (datos reales del taller en uso local). Las pruebas NUNCA la tocan.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Base exclusiva de las pruebas: debe ser otra base y su nombre debe terminar en _test.
# Se borra y se recrea en cada corrida de `npm test`.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/afix_test
# Supabase Storage para archivar los PDF emitidos (Project Settings -> API). Sin esto la
# app funciona, pero no puede emitir documentos. Guarda la clave de servicio fuera del PC.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: el Python del agente USB si no está en C:\afix-usb\venv.
# AGENTE_PYTHON=C:\afix-usb\venv\Scripts\python.exe
